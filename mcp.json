{
  "name": "restorex-mcp-server",
  "version": "1.0.0",
  "description": "RestoreX AI 逆向工程 MCP 服务",
  "homepage": "https://gitee.com/xinghunbuxiu/restorex-core",
  "license": "MIT",
  
  "server": {
    "command": "python3",
    "args": ["mcp_server.py", "--workspace", ".", "--transport", "stdio"],
    "env": {
      "PYTHONPATH": "plugin/"
    },
    "cwd": ".",
    "disabled": false,
    "autoApprove": []
  },
  
  "tools": [
    {
      "name": "restorex_analyze",
      "description": "分析混淆的 JS 代码，提取画像和识别第三方库",
      "inputSchema": {
        "type": "object",
        "properties": {
          "input_path": {
            "type": "string",
            "description": "输入代码目录路径"
          },
          "profile": {
            "type": "string",
            "enum": ["strict", "balanced", "aggressive"],
            "description": "分析策略"
          }
        },
        "required": ["input_path"]
      }
    },
    {
      "name": "restorex_execute_step",
      "description": "执行 workflow.yaml 中的指定步骤",
      "inputSchema": {
        "type": "object",
        "properties": {
          "step_id": {
            "type": "string",
            "description": "步骤 ID"
          },
          "run_id": {
            "type": "string",
            "description": "运行 ID"
          }
        },
        "required": ["step_id"]
      }
    },
    {
      "name": "restorex_read_workflow",
      "description": "读取并解析 workflow.yaml，返回所有步骤",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "restorex_extract_fingerprints",
      "description": "从分析结果中提取第三方库指纹",
      "inputSchema": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "description": "分析运行的 ID"
          }
        },
        "required": ["run_id"]
      }
    },
    {
      "name": "restorex_sync_fingerprints",
      "description": "从 Gitee 同步指纹包到本地",
      "inputSchema": {
        "type": "object",
        "properties": {
          "direction": {
            "type": "string",
            "enum": ["pull", "push"],
            "description": "同步方向"
          }
        }
      }
    },
    {
      "name": "restorex_get_status",
      "description": "获取当前项目状态",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "restorex_verify_cache",
      "description": "验证 cache 分层结构是否完整",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    }
  ],
  
  "resources": [
    {
      "uri": "workflow://current",
      "name": "当前 Workflow",
      "description": "当前项目的 workflow.yaml 内容",
      "mimeType": "text/yaml"
    },
    {
      "uri": "cache://structure",
      "name": "Cache 结构",
      "description": "当前项目的 cache 分层结构",
      "mimeType": "application/json"
    }
  ],
  
  "examples": [
    {
      "name": "完整分析流程",
      "description": "使用 RestoreX 完整分析混淆代码",
      "steps": [
        {
          "tool": "restorex_get_status",
          "description": "检查项目状态"
        },
        {
          "tool": "restorex_verify_cache",
          "description": "验证缓存结构"
        },
        {
          "tool": "restorex_sync_fingerprints",
          "arguments": {"direction": "pull"},
          "description": "同步指纹包"
        },
        {
          "tool": "restorex_read_workflow",
          "description": "读取 workflow 步骤"
        },
        {
          "tool": "restorex_execute_step",
          "arguments": {"step_id": "ensure-project-cache"},
          "description": "执行第一步"
        },
        {
          "tool": "restorex_analyze",
          "arguments": {
            "input_path": "./input",
            "profile": "strict"
          },
          "description": "分析代码"
        },
        {
          "tool": "restorex_extract_fingerprints",
          "description": "提取新指纹"
        }
      ]
    }
  ],
  
  "installation": {
    "claude": {
      "type": "stdio",
      "command": "python3 /absolute/path/to/restore_workbench/mcp_server.py --workspace /absolute/path/to/restore_workbench",
      "description": "在 Claude Desktop 中添加此 MCP 服务器"
    },
    "windsurf": {
      "type": "mcp_config",
      "path": ".windsurf/mcp.json",
      "description": "在 Windsurf 的 MCP 配置中添加"
    },
    "cursor": {
      "type": "mcp_config", 
      "path": ".cursor/mcp.json",
      "description": "在 Cursor 的 MCP 配置中添加"
    }
  }
}
