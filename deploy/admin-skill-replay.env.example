# Required to enable Mission -> Sandbox Broker Skill Replay.
EVO_SKILL_REPLAY_BROKER_SOCKET=/run/evo-sandbox-broker/broker.sock
EVO_SKILL_REPLAY_WORKSPACE_ID=evo-agent
EVO_SKILL_REPLAY_BROKER_PUBLIC_KEY=/etc/evo-admin/broker-public-key.raw
EVO_SKILL_REPLAY_BROKER_KEY_ID=evo-broker-2026-01
EVO_SKILL_REPLAY_EVIDENCE_ROOT=/var/lib/evo-admin/skill-replay-evidence

# Optional as a complete group. Without these, Broker Replay evidence is kept
# but no independent validation or Artifact Store publication is attempted.
EVO_SKILL_REPLAY_VALIDATOR_SOCKET=/run/evo-skill-validator/validator.sock
EVO_SKILL_REPLAY_VALIDATOR_PUBLIC_KEY=/etc/evo-admin/validator-public-key.raw
EVO_SKILL_REPLAY_VALIDATOR_KEY_ID=evo-validator-2026-01
