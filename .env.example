# Evo MCP 环境变量配置
# 复制此文件为 .env 并填入你的实际值

# ============================================
# 运行环境
# ============================================

# development | production
EVO_ENV=development

# HTTPS 部署时设为 true，启用 Secure Cookie
EVO_SECURE_COOKIES=false

# Session 密钥（生产必须更换）
# 生成: openssl rand -base64 32
SESSION_SECRET=evo-session-secret-change-in-production

# Admin 工作区（默认仓库根目录）
EVO_ADMIN_WORKSPACE=

# ============================================
# 自主学习模型（可选；也可在公司设置 UI 配置）
# OpenAI-compatible：DeepSeek / 通义 / 本地网关
# ============================================
# EVO_MODEL_BASE_URL=https://api.deepseek.com
# EVO_MODEL_API_KEY=
# EVO_MODEL_NAME=deepseek-chat
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# EVO_MODEL_PROVIDER_MOCK=0

# ============================================
# 渠道执行器浏览器（可选 Playwright）
# ============================================
# local（默认 stub）| playwright
# EVO_CHANNEL_BROWSER=local
# EVO_CHANNEL_LOGIN_URL=
# EVO_CHANNEL_EDITOR_URL=
# EVO_CHANNEL_BROWSER_HEADLESS=1
# EVO_CHANNEL_LOGIN_HOLD_MS=8000


# ============================================
# Gitee OAuth（Admin 登录）
# ============================================

GITEE_CLIENT_ID=your_gitee_client_id
GITEE_CLIENT_SECRET=your_gitee_client_secret
GITEE_REDIRECT_URI=http://localhost:8000/auth/callback

# 个人访问令牌 - 用于 Git 知识导出
# 获取: https://gitee.com/profile/personal_access_tokens
GITEE_TOKEN=your_gitee_token_here

# ============================================
# MySQL（用户登录，可选降级本地文件）
# ============================================

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=evo_user
DB_PASSWORD=your_db_password_here
DB_NAME=evo_db
