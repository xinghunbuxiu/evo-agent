{
  "version": "2.0",
  "platform": "evo",
  "api_base": "https://gitee.com/api/v5",
  "repos": {
    "registry": {
      "owner": "evo-project",
      "repo": "evo-registry",
      "branch": "main",
      "description": "核心注册表：所有领域的索引和配置",
      "base_url": "https://gitee.com"
    },
    "experiences": {
      "owner": "evo-project",
      "repo": "evo-experiences",
      "branch": "main",
      "description": "公司经营与工种经验库（育成复盘、运营结果）",
      "base_url": "https://gitee.com"
    },
    "knowledge": {
      "owner": "evo-project",
      "repo": "evo-knowledge",
      "branch": "main",
      "description": "通用知识库：岗位技能、运营策略、项目报告",
      "base_url": "https://gitee.com"
    }
  },
  "storage": {
    "default_shards": 4,
    "compress_threshold_mb": 10,
    "archive_after_days": 30
  },
  "learning": {
    "auto_skill_threshold": 0.8,
    "min_quality_to_record": 0.6,
    "max_experiences_per_domain": 1000
  }
}
