{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evo.local/schemas/deliverable_templates.schema.json",
  "title": "DeliverableTemplates",
  "type": "object",
  "required": ["version", "items"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["template_id", "title", "capability_types"],
        "properties": {
          "template_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "capability_types": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "fields": {
            "type": "array",
            "items": { "type": "string" }
          },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
